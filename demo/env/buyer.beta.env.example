# Superseded: hosted Seller β参加者用 buyer 設定。
# 現在の標準x402デモは packages/pay/README.md を参照。
# 1. このファイルを demo/env/buyer.mainnet.env にコピーする
#    (MCP ランチャー demo/run-mcp.sh はそのパスを読む)
# 2. <...> を運営から受け取った値・自分の値で埋める
# 3. 鍵 (agent-beta.json) は自分で生成し、絶対に共有しない
export SUBLY_RELAYER_URL=<Subly relayer API https URL>
# legacy demo compatibility only
export SUBLY_FACILITATOR_URL="$SUBLY_RELAYER_URL"
export SOLANA_RPC_URL=<自分の RPC URL (Alchemy/Helius 等の無料枠で可)>
export SUBLY_DEMO_AGENT_KEYPAIR_PATH=demo/env/keys/agent-beta.json
# 1回のツール呼び出しで支払う上限 (raw USDC)。10000 = 0.01 USDC
export SUBLY_MCP_MAX_AMOUNT_RAW_USDC=10000
