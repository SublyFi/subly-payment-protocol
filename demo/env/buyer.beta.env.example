# Superseded: buyer configuration for the hosted-seller beta.
# For the current standard x402 demo, see packages/pay/README.md.
# 1. Copy this file to demo/env/buyer.mainnet.env.
#    (The MCP launcher demo/run-mcp.sh reads that path.)
# 2. Replace <...> with values from your operator and your own configuration.
# 3. Generate the key (agent-beta.json) yourself and never share it.
export SUBLY_RELAYER_URL=<Subly relayer API https URL>
# legacy demo compatibility only
export SUBLY_FACILITATOR_URL="$SUBLY_RELAYER_URL"
export SOLANA_RPC_URL=<your RPC URL (a free Alchemy/Helius tier can be used)>
export SUBLY_DEMO_AGENT_KEYPAIR_PATH=demo/env/keys/agent-beta.json
# Maximum payment per tool call, in raw USDC. 10000 = 0.01 USDC.
export SUBLY_MCP_MAX_AMOUNT_RAW_USDC=10000
