# Buyer: detached 予行演習用
# detached では署名後のトランザクション処理まで到達しないため RPC はダミーで可。
# 使い方 (リポジトリルートで):
#   source demo/env/buyer.detached.env && npm run demo:legacy:buyer
export SUBLY_ADMIN_API_TOKEN=dev-admin
export SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
export SUBLY_DEMO_AGENT_KEYPAIR_PATH=demo/env/keys/agent-detached.json
export SUBLY_FACILITATOR_URL=http://localhost:3000
