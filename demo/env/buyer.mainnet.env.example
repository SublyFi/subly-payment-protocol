# Buyer: mainnet デモ用
# 1. このファイルを buyer.mainnet.env にコピー (gitignore 済み)
# 2. <...> を実値で埋める
# 3. source demo/env/buyer.mainnet.env && npm run demo:buyer
export SUBLY_CLIENT_API_TOKEN=dev-client
# 任意: 設定すると決済前後の yield budget が表示される
export SUBLY_ADMIN_API_TOKEN=dev-admin
export SOLANA_RPC_URL=<facilitatorと同じRPCで可>
export SUBLY_DEMO_AGENT_KEYPAIR_PATH=<vault sharesを保有するagent walletの鍵JSONパス>
