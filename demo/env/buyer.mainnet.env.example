# Legacy buyer: previous subly-yield-exact mainnet demo.
# The current standard x402 demo uses @subly_fi/pay.
# 1. Copy this file to buyer.mainnet.env (gitignored).
# 2. Replace <...> with actual values.
# 3. source demo/env/buyer.mainnet.env && npm run demo:legacy:buyer
# Optional: set this to display the yield budget before and after payment.
export SUBLY_ADMIN_API_TOKEN=dev-admin
export SOLANA_RPC_URL=<RPC URL (the same endpoint as the Subly relayer is acceptable)>
export SUBLY_DEMO_AGENT_KEYPAIR_PATH=<JSON keypair path for an agent wallet holding vault shares>
