# Legacy buyer:旧 subly-yield-exact mainnet デモ用
# 現在の標準x402デモは demo/pay-x402.ts または @subly_fi/pay を使う。
# 1. このファイルを buyer.mainnet.env にコピー (gitignore 済み)
# 2. <...> を実値で埋める
# 3. source demo/env/buyer.mainnet.env && npm run demo:legacy:buyer
# 任意: 設定すると決済前後の yield budget が表示される
export SUBLY_ADMIN_API_TOKEN=dev-admin
export SOLANA_RPC_URL=<Subly relayerと同じRPCで可>
export SUBLY_DEMO_AGENT_KEYPAIR_PATH=<vault sharesを保有するagent walletの鍵JSONパス>
