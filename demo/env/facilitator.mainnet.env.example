# Facilitator: mainnet モード (実資金が動く。/settle は本物の Kamino redeem)
# 1. このファイルを facilitator.mainnet.env にコピー (gitignore 済み)
# 2. <...> を実値で埋める
# 3. source demo/env/facilitator.mainnet.env && npm run dev
#
# 各変数の意味と要件は docs/operations.md「環境変数」を参照。
export NODE_ENV=development
export SOLANA_RPC_URL=<有料RPCエンドポイント (Helius等。公開RPCは不可)>
export SUBLY_SPONSOR_KEYPAIR_PATH=<sponsor鍵のJSONファイルパス (SOL入金済みであること)>
export SUBLY_EXTRA_LOOKUP_TABLES=<scripts/create-settlement-lut.ts が出力したLUTアドレス>
export SUBLY_SELLER_API_TOKEN=dev-seller
export SUBLY_CLIENT_API_TOKEN=dev-client
export SUBLY_ADMIN_API_TOKEN=dev-admin
