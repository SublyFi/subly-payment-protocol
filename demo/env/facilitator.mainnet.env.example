# Legacy relayer/facilitator: previous subly-yield-exact mainnet mode.
# The current flow does not require a seller-facing Subly facilitator.
# 1. Copy this file to facilitator.mainnet.env (gitignored).
# 2. Replace <...> with actual values.
# 3. source demo/env/facilitator.mainnet.env && npm run dev
#
# For current relayer configuration and prerequisites, see deploy/README.md.
export NODE_ENV=development
export SOLANA_RPC_URL=<paid RPC endpoint, such as Helius; public RPC is not supported>
export SUBLY_SPONSOR_KEYPAIR_PATH=<sponsor JSON keypair path; the wallet must be funded with SOL>
export SUBLY_EXTRA_LOOKUP_TABLES=<LUT address printed by scripts/create-settlement-lut.ts>
export SUBLY_SELLER_API_TOKEN=dev-seller
export SUBLY_ADMIN_API_TOKEN=dev-admin
