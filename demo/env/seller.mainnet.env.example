# Legacy Seller:旧 subly-yield-exact mainnet デモ用
# 現在の主導線ではSellerにSubly SDK/設定を要求しない。
# 1. このファイルを seller.mainnet.env にコピー (gitignore 済み)
# 2. <...> を実値で埋める
# 3. source demo/env/seller.mainnet.env && npm run demo:legacy:seller
export SUBLY_SELLER_API_TOKEN=dev-seller
export SUBLY_DEMO_SELLER_WALLET=<USDCを受け取るsellerウォレットの公開鍵>
# デモ価格 (raw USDC, 6 decimals)。default 10000 = 0.01 USDC
# 注意: vaultの最小net引き出し (10 raw) を超える額にすること。また決済1回に
# つき kvault のグローバル引き出しペナルティ 1000 raw (0.001 USDC) + fee debt
# が yield から必ず引かれる (旧Subly relayerの固定オーバーヘッド設定)
# export SUBLY_DEMO_PRICE_RAW_USDC=10000
