# Legacy seller: previous subly-yield-exact mainnet demo.
# The current flow does not require sellers to use Subly's SDK or configuration.
# 1. Copy this file to seller.mainnet.env (gitignored).
# 2. Replace <...> with actual values.
# 3. source demo/env/seller.mainnet.env && npm run demo:legacy:seller
export SUBLY_SELLER_API_TOKEN=dev-seller
export SUBLY_DEMO_SELLER_WALLET=<public key of the seller wallet receiving USDC>
# Demo price in raw USDC (6 decimals). Default: 10000 = 0.01 USDC.
# The amount must exceed the vault's minimum net withdrawal (10 raw).
# Each payment also deducts the kvault global withdrawal penalty of
# 1000 raw (0.001 USDC) plus fee debt from yield, according to the legacy
# Subly relayer's fixed-overhead configuration.
# export SUBLY_DEMO_PRICE_RAW_USDC=10000
