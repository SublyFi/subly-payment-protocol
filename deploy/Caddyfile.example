# Copy to deploy/Caddyfile and replace the domains (DNS A records must point
# at this host). Caddy provisions TLS certificates automatically.
#
# The seller already rate-limits challenge issuance per client IP (it sees
# real IPs via X-Forwarded-For + SUBLY_DEMO_TRUST_PROXY). Proxy-level rate
# limiting on top requires a custom Caddy build with the rate_limit module
# (github.com/mholt/caddy-ratelimit) and is optional for the closed beta.

facilitator.example.com {
	reverse_proxy facilitator:3000
}

seller.example.com {
	reverse_proxy seller:4021
}
