# Subly relayer proxy config. Copy to deploy/Caddyfile and replace the domain
# (the DNS A record must point at this host). Caddy provisions TLS
# certificates automatically.
#
# The relayer serves only the buyer-side API (wallet-signature authed vault
# flows + budget); there is no seller-facing site in the current mode.

relayer.example.com {
	reverse_proxy relayer:3000
}
