# Subly relayer (production): buyer-side vault/budget/yield-realize API.
# NOT an x402 facilitator — sellers choose their own (PayAI, CDP, ...).
# Copy to relayer.production.env and fill in.
# Plain KEY=VALUE lines (docker compose env_file; no `export`).
# DATABASE_URL and SUBLY_SPONSOR_KEYPAIR_PATH are set by docker-compose.yml.
NODE_ENV=production
SOLANA_RPC_URL=<dedicated RPC endpoint URL>
SUBLY_EXTRA_LOOKUP_TABLES=<settlement lookup table address>
# Operator token (e.g. `openssl rand -hex 24`). Buyers need no token: their
# requests are wallet-signature authenticated.
SUBLY_ADMIN_API_TOKEN=<random>
# Retired subly-yield-exact seller endpoints (/v1/x402/*) stay OFF unless
# this is set to 1; SUBLY_SELLER_API_TOKEN is only read when enabled.
# SUBLY_ENABLE_LEGACY_X402=1
# SUBLY_SELLER_API_TOKEN=<random>
# Behind the Caddy reverse proxy the per-IP rate limiter must see real
# client IPs from X-Forwarded-For.
SUBLY_TRUST_PROXY=1
# Per-IP API rate (requests/minute, token bucket); 0 disables.
SUBLY_API_RATE_PER_MIN=240
# Alert threshold for scripts/check-sponsor-balance.sh (0.1 SOL default).
SUBLY_MIN_SPONSOR_BALANCE_LAMPORTS=100000000
# Spending-mandate enforcement (docs/spending-mandate-design.md), staged
# rollout: off | warn (default: violations logged only) | on (enforced).
# Flip to `on` once clients send the payment binding on yield_realize.
SUBLY_MANDATE_ENFORCEMENT=warn
# Owner pages (setup / approve / revoke) are served by the relayer itself.
# These bases build the links the agent pastes into chat AND (unless
# overridden below) derive the WebAuthn rpId/origins — so they MUST point
# at the host that serves the pages. Passkeys bind to that rpId.
SUBLY_APPROVE_URL_BASE=https://api.demo.sublyfi.com/approve/
SUBLY_SETUP_URL_BASE=https://api.demo.sublyfi.com/setup/
# Explicit WebAuthn overrides for split deployments (comma-separated origins).
# SUBLY_WEBAUTHN_RP_ID=api.demo.sublyfi.com
# SUBLY_WEBAUTHN_ORIGINS=https://api.demo.sublyfi.com
