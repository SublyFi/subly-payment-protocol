# Hosted seller (production). Copy to seller.production.env and fill in.
# Plain KEY=VALUE lines. SUBLY_FACILITATOR_URL / SUBLY_DEMO_TRUST_PROXY are
# set by docker-compose.yml.
SUBLY_SELLER_API_TOKEN=<same value as the facilitator env>
SUBLY_DEMO_SELLER_WALLET=<operator wallet that receives USDC (ATA must exist)>
# Public URL of this seller; must match the Caddy domain exactly — buyers pay
# for the canonical https resource URL.
SUBLY_DEMO_SELLER_BASE_URL=https://seller.example.com
# Price per request in raw USDC (10000 = 0.01 USDC). Keep well above the
# ~2400-raw fixed overhead per payment (withdrawal penalty + fee debt).
SUBLY_DEMO_PRICE_RAW_USDC=10000
# Challenge issuance rate limits (per minute).
SUBLY_DEMO_CHALLENGE_RATE_PER_MIN=10
SUBLY_DEMO_CHALLENGE_RATE_GLOBAL_PER_MIN=120
