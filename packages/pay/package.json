    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@solana-program/address-lookup-table": "^0.7.0",
    "@solana/kit": "^2.3.0",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3",
    "x402-solana": "^2.0.4",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SublyFi/subly-payment-protocol"
  }
