{
  "name": "@subly_fi/pay",
  "version": "0.5.0",
  "description": "Subly client: pay compatible standard x402 Solana USDC exact APIs from Kamino vault yield — the seller needs no Subly integration. Ships an MCP server and a one-shot pay/deposit CLI; non-custodial (signs locally with your own key).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "pay": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@solana-program/address-lookup-table": "^0.10.0",
    "@solana/kit": "^5.1.0",
    "@x402/fetch": "^2.17.0",
    "@x402/svm": "^2.17.0",
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SublyFi/subly-payment-protocol"
  }
}
